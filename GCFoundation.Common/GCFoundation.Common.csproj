<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>All</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ErrorLog>$(OutputPath)Foundation.Components.Common.sarif</ErrorLog>

    <!-- NuGet package metadata -->
    <PackageId>GCFoundation.Common</PackageId>
    <Version>1.0.0</Version>
    <Authors>Philippe G. Vadnais;Shawn Turcotte</Authors>
    <Company>TBS-SCT</Company>
    <Description>Shared utilities and models used across GCFoundation applications.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tbs-imtd/GCFoundation</RepositoryUrl>
    <PackageProjectUrl>https://github.com/tbs-imtd/GCFoundation</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <IncludeSource>true</IncludeSource>
    <PackageTags>GCFoundation;GCDS;GC Design System;Government of Canada;Common;Utilities;ASP.NET;NET</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Enums\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Settings\cdn-integrity.json" />
    <EmbeddedResource Include="Settings\cdn-integrity.json" LogicalName="GCFoundation.Common.cdn-integrity.json" />
  </ItemGroup>

  <!-- README for NuGet.org -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
