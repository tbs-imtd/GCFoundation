@using GCFoundation.Components.Resources
@using GCFoundation.Components.Settings
@using Microsoft.Extensions.Options

@inject IOptions<GCFoundationSessionSetting> sessionSetting;

<fdcp-session-modal modal-id="session-extend-modal" title="@Modal.ModalExtendSession_Title" static-backdrop hide-close-button
session-timeout="@sessionSetting.Value.SessionTimeout" 
reminder-time="@sessionSetting.Value.ReminderTime" 
refresh-url="@sessionSetting.Value.RefreshURL" 
logout-url="@sessionSetting.Value.LogoutURL">
	<div slot="body">
		<p>@Html.Raw(Modal.ModalExtendSession_Text)</p>
	</div>
	<div slot="footer">
		<gcds-button button-id="session-extend-refresh-btn" button-role="primary">@Modal.ModalExtendSession_Extend_Btn</gcds-button>
		<gcds-button button-id="session-extend-logout-btn" button-role="danger" type="link" href="@sessionSetting.Value.LogoutURL">@Modal.ModalExtendSession_Logout_Btn</gcds-button>
	</div>
</fdcp-session-modal>