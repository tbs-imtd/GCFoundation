@using GCFoundation.Components.Enums
@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Html.Raw(Template.Crud_Name)</gcds-heading>

<div class="documentation-content">
    @* Introduction *@
    <gcds-text>@Html.Raw(Template.Crud_Intro)</gcds-text>

    @* When to Use *@
    <gcds-heading tag="h2" id="@Template.WhenToUse_Anchor">@Template.WhenToUse</gcds-heading>
    @Html.Raw(string.Format(Template.Crud_WhenToUse, Url.Action("Index", "Components")))

    @* Preview *@
    <gcds-heading tag="h2" id="@Template.Preview_Anchor">@Template.Preview</gcds-heading>
    <p>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("CrudDemo", "Template")">@Template.Demo_Button <i class="ms-100 fa-solid fa-desktop"></i></gcds-button>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("CrudCode", "Template")">@Template.Code_Button <i class="ms-100 fa-solid fa-code"></i></gcds-button>
    </p>
    @* Preview image *@
    <img src="@Url.Content($"~/images/templates/crud-demo-{Localization.ThreeLetterLanguage}.png")" alt="@Template.Crud_Demo_Image_AltText" class="border rounded w-75" />

    @* How to implement *@
    <gcds-heading tag="h2" id="@Template.HowToImplement_Anchor">@Template.HowToImplement</gcds-heading>
    @Html.Raw(string.Format(Template.Crud_HowToImplement, Url.Action("Index", "Installation")))

    @* Notes/Highlights *@
    <gcds-heading tag="h2" id="@Template.Notes_Anchor">@Template.Notes</gcds-heading>
    @Html.Raw(Template.Crud_Notes)
</div>