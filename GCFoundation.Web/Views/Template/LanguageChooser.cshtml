@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.LanguageChooser_Name</gcds-heading>

<div class="documentation-content">
    @* Introduction *@
    @Html.Raw(Template.LanguageChooser_Intro)

    @* When to Use *@
    <gcds-heading tag="h2" id="@Template.WhenToUse_Anchor">@Template.WhenToUse</gcds-heading>
    @Html.Raw(Template.LanguageChooser_WhenToUse)

    @* Preview *@
    <gcds-heading tag="h2" id="@Template.Preview_Anchor">@Template.Preview</gcds-heading>
    <p>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("LanguageChooserDemo", "Template")" target="_blank">@Template.Demo_Button <i class="ms-100 fa-solid fa-desktop"></i></gcds-button>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("LanguageChooserCode", "Template")" target="_blank">@Template.Code_Button <i class="ms-100 fa-solid fa-code"></i></gcds-button>
    </p>
    @* Preview image *@
    <img src="@Url.Content($"~/images/templates/language-chooser-demo.png")" alt="@Template.LanguageChooser_Demo_Image_AltText" class="border rounded w-75" />

    @* How to implement *@
    <gcds-heading tag="h2" id="@Template.HowToImplement_Anchor">@Template.HowToImplement</gcds-heading>
    @Html.Raw(string.Format(Template.LanguageChooser_HowToImplement, Url.Action("Index", "Installation")))

    @* Notes/Highlights *@
    <gcds-heading tag="h2" id="@Template.Notes_Anchor">@Template.Notes</gcds-heading>
    @Html.Raw(Template.LanguageChooser_Notes)
</div>
