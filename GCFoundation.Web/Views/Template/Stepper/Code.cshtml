@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.Stepper_Code_Name</gcds-heading>
@Html.Raw(Template.Stepper_Code_Intro)

<pre><code class="language-cshtml">@@using GCFoundation.Components.Models
@@using GCFoundation.Components.Resources
@@using GCFoundation.Web.Resources
@@model GCFoundation.Web.Models.Template.TemplateStepperFormViewModel

&lt;fdcp-stepper current-step="@@Model.CurrentStep"
              heading-title="@@currentStepHeading"
              steps="@@stepperSteps"&gt;&lt;/fdcp-stepper&gt;

&lt;fdcp-form method="post" action="@Url.Action("StepperDemo", "Template")" for="@@Model"&gt;
    @@Html.AntiForgeryToken()
    &lt;input type="hidden" name="CurrentStep" value="@@Model.CurrentStep" /&gt;

    @* Preserve answers from other steps *@
    &lt;partial name="Stepper/_StepHiddenState" model="Model" /&gt;

    @* Each step renders unique fields *@
    @@switch (Model.CurrentStep)
    {
        case 1:
            &lt;partial name="Stepper/_Step1Intro" model="Model" /&gt;
            break;
        case 2:
            &lt;partial name="Stepper/_Step2Info" model="Model" /&gt;
            break;
        case 3:
            &lt;partial name="Stepper/_Step3Details" model="Model" /&gt;
            break;
        case 4:
            &lt;partial name="Stepper/_Step4Review" model="Model" /&gt;
            break;
        case 5:
            &lt;partial name="Stepper/_Step5Submit" model="Model" /&gt;
            break;
    }

    &lt;gcds-button type="submit" name="nav" value="prev" button-role="secondary"&gt;Previous&lt;/gcds-button&gt;
    &lt;gcds-button type="submit" name="nav" value="next"&gt;Next / Submit&lt;/gcds-button&gt;
&lt;/fdcp-form&gt;</code></pre>

<gcds-heading tag="h2">Step-scoped validation</gcds-heading>
<gcds-text>
    Validate only the fields for the step being left. Map each step to its property names
    (see <code>TemplateStepperFormViewModel.FieldsByStep</code>) and remove other
    <code>ModelState</code> errors before checking <code>ModelState.IsValid</code>.
    On the final step, a valid Submit redirects to a success confirmation page
    (<code>StepperDemoSuccess</code>).
</gcds-text>
