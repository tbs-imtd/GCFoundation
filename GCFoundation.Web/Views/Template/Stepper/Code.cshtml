@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.Stepper_Code_Name</gcds-heading>
@Html.Raw(Template.Stepper_Code_Intro)

<fdcp-code code-language="cshtml">@@using GCFoundation.Components.Models
@@using GCFoundation.Components.Resources
@@using GCFoundation.Web.Resources
@@model GCFoundation.Web.Models.Template.TemplateStepperFormViewModel

&lt;gcds-heading tag="h1"&gt;@Template.Stepper_Demo_Name&lt;/gcds-heading&gt;
&lt;fdcp-stepper current-step="2"
              steps="@@(new List&lt;StepperStep&gt;
                                {
                                    new StepperStep { StepNumber = 1, Label = "@Template.Stepper_Demo_Step1_Label", DisplayMode = StepperStepDisplayMode.Icon, CompletedIconHtml = "&lt;i class='fa fa-check'&gt;&lt;/i&gt;" },
                                    new StepperStep { StepNumber = 2, Label = "@Template.Stepper_Demo_Step2_Label", DisplayMode = StepperStepDisplayMode.Icon, InProgressIconHtml = "&lt;i class='fa fa-spinner'&gt;&lt;/i&gt;" },
                                    new StepperStep { StepNumber = 3, Label = "@Template.Stepper_Demo_Step3_Label", DisplayMode = StepperStepDisplayMode.Number },
                                    new StepperStep { StepNumber = 4, Label = "@Template.Stepper_Demo_Step4_Label", DisplayMode = StepperStepDisplayMode.Number },
                                    new StepperStep { StepNumber = 5, Label = "@Template.Stepper_Demo_Step5_Label", DisplayMode = StepperStepDisplayMode.Number }
                                })"&gt;&lt;/fdcp-stepper&gt;

@@if (!ViewData.ModelState.IsValid)
{
    &lt;fdcp-error-summary for="@@Model" /&gt;
}

&lt;fdcp-form method="post" action="@Url.Action("StepperDemo", "Template")" for="@@Model"&gt;
    @@Html.AntiForgeryToken()

    &lt;fdcp-input for="@@Model.FirstName" /&gt;
    &lt;fdcp-input for="@@Model.LastName" /&gt;

    &lt;fdcp-select for="@@Model.Province" items="@@Model.ProvinceList" /&gt;

    &lt;fdcp-checkboxes for="@@Model.ContactOptions" items="@@Model.ContactOptionsList" /&gt;

    &lt;div class="mt-200"&gt;
        &lt;gcds-button type="submit" name="nav" value="prev" button-role="secondary"&gt;@Localization.Previous&lt;/gcds-button&gt;
        &lt;gcds-button type="submit" name="nav" value="next"&gt;@Localization.Next&lt;/gcds-button&gt;
        &lt;gcds-button type="reset" button-role="secondary"&gt;@Localization.Reset&lt;/gcds-button&gt;
    &lt;/div&gt;
&lt;/fdcp-form&gt;</fdcp-code>