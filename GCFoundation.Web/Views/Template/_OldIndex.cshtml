@using GCFoundation.Components.Models
@using GCFoundation.Components.TagHelpers.GCDS
@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Routing

<gcds-heading tag="h1" margin-bottom="400">@Template.Index_PageTitle</gcds-heading>
<gcds-text>@Template.Index_PageDescription</gcds-text>

@{
    var template = new List<CardTagHelper>()
    {
        new CardTagHelper() { CardTitle = Template.Index_Basic_Title, Description = Template.Index_Basic_Description, Href = @Url.Action("Badge", "Components") ?? string.Empty },
        new CardTagHelper() { CardTitle = Template.Index_Error_Title, Description = Template.Index_Error_Description, Href = @Url.Action("Card", "Components") ?? string.Empty },
        new CardTagHelper() { CardTitle = Template.Index_LanguageChooser_Title, Description = Template.Index_LanguageChooser_Description, Href = @Url.Action("FilteredSearch", "Components") ?? string.Empty },
        new CardTagHelper() { CardTitle = Template.Index_Stepper_Title, Description = Template.Index_Stepper_Description, Href = @Url.Action("FormBuilder", "Components") ?? string.Empty }
    };
}

<gcds-grid columns="repeat(3, 1fr)" equal-row-height>
    @foreach (var template in template.OrderBy(c => c.CardTitle))
    {
        <gcds-card card-title="@template.CardTitle"
                   description="@template.Description"
                   href="@template.Href"></gcds-card>
    }
</gcds-grid>

<gcds-grid columns-desktop="1fr 3fr" columns="1fr">
    <gcds-side-nav label="@Template.SideNav_Label">
        <gcds-nav-link href="#main-template">@Template.SideNav_MainTemplate</gcds-nav-link>
        <gcds-nav-link href="#error-templates">@Template.SideNav_ErrorTemplates</gcds-nav-link>
        <gcds-nav-link href="#language-chooser">@Template.SideNav_LanguageChooser</gcds-nav-link>
        <gcds-nav-link href="#account-partial">@Template.SideNav_AccountPartial</gcds-nav-link>
    </gcds-side-nav>

    <div>
        <gcds-heading tag="h2" id="main-template">
            @Template.Section_MainTemplate_Title
        </gcds-heading>
        <gcds-text>
            @Template.Section_MainTemplate_Description
        </gcds-text>

        <gcds-heading tag="h2" id="error-templates">
            @Template.Section_ErrorTemplates_Title
        </gcds-heading>
        <gcds-text>
            @Template.Section_ErrorTemplates_Description
            <ul>
                <li><gcds-link href="@Url.Action("GlobalError", "Errors")">Global error</gcds-link></li>
                <li><gcds-link href="@Url.Action("NotFoundError", "Errors")">Not found</gcds-link></li>
            </ul>
        </gcds-text>

        <gcds-heading tag="h2" id="language-chooser">
            @Template.Section_LanguageChooser_Title
        </gcds-heading>
        <gcds-text>
            @Template.Section_LanguageChooser_Description
        </gcds-text>

        <gcds-heading tag="h2" id="account-partial" class="mt-400">
            @Template.Section_AccountPartial_Title
        </gcds-heading>
        <gcds-text>
            @Template.Section_AccountPartial_Description
        </gcds-text>
        
        <gcds-heading tag="h3" class="mt-300">Template Integration</gcds-heading>
        <gcds-text>
            The Account Partial integrates seamlessly with the Foundation Layout template. 
            Simply set the partial name in your controller and it will automatically appear in the designated area.
        </gcds-text>
        
        <gcds-details details-title="Controller Implementation" class="mt-200">
            <pre><code>public class HomeController : GCFoundationBaseController
{
    public IActionResult Index()
    {
        // Enable the account partial in the layout
        ViewData["AccountPartialViewName"] = "_AccountPartial";
        return View();
    }
}</code></pre>
        </gcds-details>

        <gcds-details details-title="Layout Integration" class="mt-200">
            <gcds-text>The Foundation Layout (_FoundationLayout.cshtml) includes this code:</gcds-text>
            <pre><code>@@{
    string? AccountPartialViewName = ViewData["AccountPartialViewName"] as string;
}

@@if(!string.IsNullOrEmpty(AccountPartialViewName))
{
    @@await Html.PartialAsync(AccountPartialViewName)
}</code></pre>
        </gcds-details>

        <gcds-heading tag="h3" class="mt-300">Authentication System Integration</gcds-heading>
        <gcds-text>
            The partial automatically works with various authentication systems by reading user information from claims:
        </gcds-text>

        <gcds-grid columns="1fr" columns-tablet="1fr 1fr" class="mt-200">
            <gcds-card card-title="Cookie Authentication" tag="div">
                <gcds-text>Stateless cookie authentication without server sessions.</gcds-text>
                <gcds-text class="mt-100">
                    <gcds-link href="@Url.Action("Index", "StatelessAuthExample")">View Examples</gcds-link>
                </gcds-text>
            </gcds-card>
            
            <gcds-card card-title="Azure Active Directory" tag="div">
                <gcds-text>Enterprise authentication with Office 365 integration.</gcds-text>
                <gcds-text class="mt-100">
                    <gcds-link href="@Url.Action("AzureAdExample", "StatelessAuthExample")">Azure AD Guide</gcds-link>
                </gcds-text>
            </gcds-card>
        </gcds-grid>

        <gcds-heading tag="h3" class="mt-300">Template Customization</gcds-heading>
        <gcds-text>
            You can customize the partial's behavior through configuration and create multiple variants for different parts of your application:
        </gcds-text>

        <gcds-details details-title="Multiple Partial Variants" class="mt-200">
            <pre><code>// Create different partials for different areas
ViewData["AccountPartialViewName"] = "_HeaderAccount";    // Header area
ViewData["AccountPartialViewName"] = "_SidebarAccount";   // Sidebar area  
</code></pre>
        </gcds-details>

        <gcds-details details-title="Dynamic Configuration" class="mt-200">
            <pre><code>// Customize settings based on user role or page type
var userModel = _accountService.CreateViewModelFromContext();

if (User.IsInRole("Admin"))
{
    userModel.Settings.ShowUserEmail = true;
    userModel.Settings.ShowUserRole = true;
}

if (Request.Path.StartsWithSegments("/admin"))
{
    // Customize admin-specific settings here
}</code></pre>
        </gcds-details>

        <gcds-heading tag="h3" class="mt-300">Complete Examples</gcds-heading>
        <gcds-text>
            For comprehensive examples and interactive demonstrations:
        </gcds-text>
        <ul class="mt-200">
            <li><gcds-link href="@Url.Action("Account", "Components")">Component Documentation</gcds-link> - Full component showcase</li>
            <li><gcds-link href="@Url.Action("Index", "AccountExample")">Interactive Examples</gcds-link> - Working demonstrations</li>
            <li><gcds-link href="@Url.Action("Index", "StatelessAuthExample")">Authentication Integration</gcds-link> - Cloud-ready auth examples</li>
        </ul>
    </div>
</gcds-grid>

<style>
    pre {
        background: var(--gcds-color-background-light);
        padding: 1rem;
        border-radius: 0.25rem;
        overflow-x: auto;
        font-size: 0.875rem;
        margin: 0.5rem 0;
    }
    
    code {
        font-family: 'Courier New', monospace;
    }
</style>