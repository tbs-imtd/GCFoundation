@using System.Reflection
@using System.ComponentModel.DataAnnotations;
@using GCFoundation.Web.Models.Template.Crud;
@using GCFoundation.Web.Resources
@model EmployeeViewModel;
@{
    var properties = Model.GetType()
            .GetProperties()
            .Where(p => p.GetCustomAttribute<DisplayAttribute>() != null)
            .OrderBy(p => p.GetCustomAttribute<DisplayAttribute>()!.Order);
}

<gcds-heading tag="h1">@Template.Crud_Profile_PageTitle</gcds-heading>
<gcds-heading tag="h2">@Model.Name</gcds-heading>
@foreach(var prop in properties)
{
    if (prop.Name != "Name")
    {
        var displayName = prop.GetCustomAttribute<DisplayAttribute>()!.GetName();
        <gcds-text><strong>@displayName: </strong>@Html.Display(prop.Name)</gcds-text>
    }
}

<section class="mt-400">
    <gcds-button button-role="secondary" type="link" href="@Url.Action("CrudDemo", "Template")"><gcds-icon name="chevron-left" margin-right="50"></gcds-icon>@Template.Crud_BackToEmployeeList_Button</gcds-button>
</section>

