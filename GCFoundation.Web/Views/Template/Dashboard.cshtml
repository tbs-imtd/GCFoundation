@using GCFoundation.Components.Enums
@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<gcds-heading tag="h1">@Template.Dashboard_Name</gcds-heading>

<gcds-notice class="mb-200" notice-role="@AlertType.warning" notice-title="Work in progress..." notice-title-tag="h2">This page is under development.</gcds-notice>

<div class="documentation-content">
    @* Introduction *@
    <gcds-text>@Html.Raw(Template.Dashboard_Intro)</gcds-text>

    @* When to Use *@
    <gcds-heading tag="h2" id="@Template.WhenToUse_Anchor">@Template.WhenToUse</gcds-heading>
    @Html.Raw(string.Format(Template.Dashboard_WhenToUse, Url.Action("Index", "Components")))

    @* Preview *@
    <gcds-heading tag="h2" id="@Template.Preview_Anchor">@Template.Preview</gcds-heading>
    <p>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("DashboardDemo", "Template")">@Template.Demo_Button <i class="ms-100 fa-solid fa-desktop"></i></gcds-button>
        <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("DashboardCode", "Template")">@Template.Code_Button <i class="ms-100 fa-solid fa-code"></i></gcds-button>
    </p>
    @* Preview image *@
    @* <img src="@Url.Content($"~/images/templates/basic-demo-{Localization.ThreeLetterLanguage}.png")" alt="@Template.Basic_Demo_Image_AltText" class="border rounded w-75" /> *@

    @* How to implement *@
    <gcds-heading tag="h2" id="@Template.HowToImplement_Anchor">@Template.HowToImplement</gcds-heading>
    @Html.Raw(string.Format(Template.Dashboard_HowToImplement, Url.Action("Index", "Installation")))

    @* Notes/Highlights *@
    <gcds-heading tag="h2" id="@Template.Notes_Anchor">@Template.Notes</gcds-heading>
    @Html.Raw(Template.Dashboard_Notes)
</div>