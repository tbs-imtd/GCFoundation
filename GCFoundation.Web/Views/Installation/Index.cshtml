dotnet add YourApp.Web package GCFoundation.Components
dotnet add YourApp.Web package GCFoundation.Security</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <p>@Installation.Index_PackageInstallation_NavigationPackages_Intro</p>
<div class="code-container">
<pre><code class="language-powershell">dotnet add YourApp.Web package cloudscribe.Web.Navigation
dotnet add YourApp.Web package cloudscribe.Web.Localization
dotnet add YourApp.Web package cloudscribe.Web.SiteMap
dotnet add YourApp.Web package cloudscribe.Web.SiteMap.FromNavigation
dotnet add YourApp.Web package RouteLocalization.AspNetCore</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <p>@Installation.Index_PackageInstallation_PackageManager_Intro</p>
<div class="code-container">
<pre><code class="language-powershell">Install-Package GCFoundation.Common
Install-Package GCFoundation.Components
Install-Package GCFoundation.Security
Install-Package cloudscribe.Web.Navigation
Install-Package cloudscribe.Web.Localization
Install-Package cloudscribe.Web.SiteMap
Install-Package cloudscribe.Web.SiteMap.FromNavigation
Install-Package RouteLocalization.AspNetCore</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

        <gcds-heading tag="h2" id="basic-setup">@Installation.Index_BasicSetup_Heading</gcds-heading>
        <p>@Html.Raw(Installation.Index_BasicSetup_Intro)</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_MvcLocalization))
builder.Services.AddControllersWithViews()
    .AddViewLocalization()
    .AddDataAnnotationsLocalization();

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_RegisterGCFoundationServices))
builder.Services.AddGCFoundationComponents(builder.Configuration);
builder.Services.AddGCFoundationContentPolicies(builder.Configuration);
builder.Services.AddGCFoundationSession(builder.Configuration);
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

        <gcds-heading tag="h2" id="components-setup">@Installation.Index_ComponentsSetup_Heading</gcds-heading>
        <p>@Html.Raw(Installation.Index_ComponentsSetup_Intro)</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_LoadComponents))
app.UseGCFoundationComponents();
app.UseGCFoundationSession();
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

        <gcds-heading tag="h2" id="security-setup">@Installation.Index_SecuritySetup_Heading</gcds-heading>
        <p>@Installation.Index_SecuritySetup_Intro</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_AddContentSecurityPolicy))
app.UseGCFoundationContentPolicies();

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_ConfigureSecureCookies))
app.UseCookiePolicy(new CookiePolicyOptions
{
    MinimumSameSitePolicy = SameSiteMode.Strict,
    Secure = CookieSecurePolicy.Always,
    HttpOnly = HttpOnlyPolicy.Always
});
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

        <gcds-heading tag="h2" id="language-setup">@Installation.Index_LanguageSetup_Heading</gcds-heading>
        <p>@Html.Raw(Installation.Index_LanguageSetup_Configuration_Intro)</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_ConfigureGlobalResources))
builder.Services.Configure<GlobalResourceOptions>(builder.Configuration.GetSection("GlobalResourceOptions"));
builder.Services.AddSingleton<IStringLocalizerFactory, GlobalResourceManagerStringLocalizerFactory>();
builder.Services.AddLocalization();

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_ConfigureSupportedCultures))
var supportedCultures = LanguageUtility.GetSupportedCulture();
var routeSegmentLocalizationProvider = new FirstUrlSegmentRequestCultureProvider(supportedCultures.ToList());

builder.Services.Configure<RequestLocalizationOptions>(options =>
{
    options.DefaultRequestCulture = new RequestCulture(culture: "en-CA", uiCulture: "en-CA");
    options.SupportedCultures = supportedCultures;
    options.SupportedUICultures = supportedCultures;
    options.RequestCultureProviders.Insert(0, routeSegmentLocalizationProvider);
});

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_AddRouteLocalization))
builder.Services.AddCustomRouteLocalization();
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <p>@Installation.Index_LanguageSetup_Middleware_Intro</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_AddLanguageMiddleware))
app.UseMiddleware<GCFoundationLanguageMiddleware>();

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_EnableRequestLocalization))
var localizationOptions = app.Services.GetRequiredService&lt;IOptions&lt;RequestLocalizationOptions&gt;&gt;().Value;
app.UseRequestLocalization(localizationOptions);
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

        <gcds-heading tag="h2" id="breadcrumbs-setup">@Installation.Index_BreadcrumbsSetup_Heading</gcds-heading>
        <p>@Html.Raw(Installation.Index_BreadcrumbsSetup_Intro)</p>
<div class="code-container">
<pre><code class="language-csharp">// @Html.Raw(Html.Encode(Installation.Index_CodeComment_ConfigureNavigationServices))
builder.Services.AddScoped&lt;ISiteMapNodeService, NavigationTreeSiteMapNodeService&gt;();
builder.Services.AddCloudscribeNavigation(builder.Configuration.GetSection("NavigationOptions"));

// @Html.Raw(Html.Encode(Installation.Index_CodeComment_ConfigureBreadcrumbsLocalization))
builder.Services.AddSingleton(typeof(IBreadcrumbsLocalizationService),
    typeof(BreadcrumbsLocalizationService&lt;YourApp.Resources.Navigation&gt;));
</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Installation.Index_CopyButton_SuccessText">@Installation.Index_CopyButton_Text</gcds-button></pre>
</div>

        <hr />

