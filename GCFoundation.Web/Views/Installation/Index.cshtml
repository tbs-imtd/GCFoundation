<gcds-grid columns="minmax(200px, 300px) minmax(0, 1fr)" align-content="@GCFoundation.Components.Enums.AlignContent.start">
    <gcds-side-nav label="@Installation.Index_SideNav_OnThisPage">
        <gcds-nav-link href="#prerequisites">@Installation.Index_Prerequisites_Heading</gcds-nav-link>
        <gcds-nav-link href="#nuget-configuration">@Installation.Index_NuGetConfiguration_Heading</gcds-nav-link>
        <gcds-nav-link href="#package-installation">@Installation.Index_PackageInstallation_Heading</gcds-nav-link>
