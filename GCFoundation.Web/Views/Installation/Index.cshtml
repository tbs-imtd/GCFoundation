        <p>@Html.Raw(Installation.Index_UrlTranslation_Extension)</p>
<fdcp-code code-language="csharp">using MyApp.Controllers;
using RouteLocalization.AspNetCore;

namespace MyApp;

public static class RouteLocalizationExtensions
{
    public static IServiceCollection AddAppRouteLocalization(this IServiceCollection services)
    {
        services.AddRouteLocalization(setup =&gt;
        {
            setup.UseCulture("fr")
                .WhereController(nameof(HomeController))
                .TranslateController("accueil")
                .WhereAction(nameof(HomeController.Index))
                .TranslateAction("");

            setup.UseCulture("fr")
                .WhereController(nameof(HomeController))
                .WhereAction(nameof(HomeController.Privacy))
                .TranslateAction("confidentialite");

            // @Html.Raw(Html.Encode(Installation.Index_CodeComment_DefaultTranslation))
            setup.UseCultures(["en", "fr"])
                .WhereUntranslated()
                .AddDefaultTranslation();
        });

        return services;
    }
}</fdcp-code>
        <p>@Html.Raw(Installation.Index_UrlTranslation_Register)</p>
