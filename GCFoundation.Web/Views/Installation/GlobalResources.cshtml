@using GCFoundation.Components.Helpers
@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources
@inject GlobalResourceHelper ResourceHelper

<gcds-heading tag="h1">@Installation.GlobalResources_Page_Title</gcds-heading>
<gcds-text>@Html.Raw(Installation.GlobalResources_Description)</gcds-text>

<section>
    <gcds-heading tag="h2">@Installation.GlobalResources_CurrentConfiguration_Title</gcds-heading>
    <gcds-text>@Html.Raw(Installation.GlobalResources_CurrentConfiguration_Description)</gcds-text>

    <gcds-details details-title="@Installation.GlobalResources_GlobalCssFiles_Title">
        @if (ResourceHelper.GetGlobalCssFiles().Any())
        {
            <ul>
                @foreach (var cssFile in ResourceHelper.GetGlobalCssFiles())
                {
                    <li><code>@cssFile</code></li>
                }
            </ul>
        }
        else
        {
            <gcds-text>@Installation.GlobalResources_NoCssFiles</gcds-text>
        }
    </gcds-details>

    <gcds-details details-title="@Installation.GlobalResources_GlobalJavaScriptFiles_Title">
        @if (ResourceHelper.GetGlobalJavaScriptFiles().Any())
        {
            <ul>
                @foreach (var jsFile in ResourceHelper.GetGlobalJavaScriptFiles())
                {
                    <li><code>@jsFile</code></li>
                }
            </ul>
        }
        else
        {
            <gcds-text>@Installation.GlobalResources_NoJavaScriptFiles</gcds-text>
        }
    </gcds-details>

    <gcds-details details-title="@Installation.GlobalResources_GlobalMetaTags_Title">
        @if (ResourceHelper.GetGlobalMetaTags().Any())
        {
            <ul>
                @foreach (var metaTag in ResourceHelper.GetGlobalMetaTags())
                {
                    <li>
                        <code>@(metaTag.Render())</code>
                    </li>
                }
            </ul>
        }
        else
        {
            <gcds-text>@Installation.GlobalResources_NoMetaTags</gcds-text>
        }
    </gcds-details>

    <gcds-details details-title="@Installation.GlobalResources_GlobalLinkTags_Title">
        @if (ResourceHelper.GetGlobalLinkTags().Any())
        {
            <ul>
                @foreach (var linkTag in ResourceHelper.GetGlobalLinkTags())
                {
                    <li><code>@linkTag</code></li>
                }
            </ul>
        }
        else
        {
            <gcds-text>@Installation.GlobalResources_NoLinkTags</gcds-text>
        }
    </gcds-details>
</section>

<section>
    <gcds-heading tag="h2">@Installation.GlobalResources_ResourceInclusion_Title</gcds-heading>
    <gcds-text>@Installation.GlobalResources_ResourceInclusion_Description</gcds-text>

    <ul>
        <li><strong>@Installation.GlobalResources_DefaultCss_Label</strong> <span class="status-enabled">@Installation.GlobalResources_AlwaysEnabled</span> (foundation.min.css, grid.js, prism)</li>
        <li><strong>@Installation.GlobalResources_DefaultJavaScript_Label</strong> <span class="status-enabled">@Installation.GlobalResources_AlwaysEnabled</span> (foundation.min.js, grid.js, prism)</li>
        <li><strong>@Installation.GlobalResources_GCDSResources_Label</strong> @(ResourceHelper.ShouldIncludeGCDSResources() ? Localization.Enabled : Localization.Disabled)</li>
        <li><strong>@Installation.GlobalResources_FontAwesome_Label</strong> @(ResourceHelper.ShouldIncludeFontAwesome() ? Localization.Enabled : Localization.Disabled)</li>
    </ul>

    <gcds-text>@Html.Raw(Installation.GlobalResources_DefaultFilesNote)</gcds-text>
</section>

<section>
    <gcds-heading tag="h2">@Installation.GlobalResources_LoadingOrder_Title</gcds-heading>
    
    <gcds-text>@Installation.GlobalResources_LoadingOrder_Description</gcds-text>

    <gcds-details details-title="@Installation.GlobalResources_CssLoadingOrder_Title">
        <ol>
            <li><strong>Default foundation CSS</strong> (always included):
                <ul>
                    <li><code>foundation.min.css</code></li>
                    <li><code>prism/css/prism.css</code></li>
                </ul>
            </li>
            <li>GCDS CSS from CDN (if enabled)</li>
            <li>Font Awesome CSS from CDN (if enabled)</li>
            <li>Global CSS files from configuration</li>
            <li>Page-specific styles</li>
        </ol>
    </gcds-details>

    <gcds-details details-title="@Installation.GlobalResources_JavaScriptLoadingOrder_Title">
        <ol>
            <li>GCDS JavaScript from CDN (if enabled)</li>
            <li><strong>Default foundation JavaScript</strong> (always included):
                <ul>
                    <li><code>prism/js/prism.js</code></li>
                    <li><code>foundation.min.js</code></li>
                </ul>
            </li>
            <li>Global JavaScript files from configuration</li>
            <li>Page-specific scripts</li>
        </ol>
    </gcds-details>
</section>

<section>
    <gcds-heading tag="h2">@Installation.GlobalResources_HowToConfigure_Title</gcds-heading>
    <gcds-text>@Html.Raw(Installation.GlobalResources_HowToConfigure_Description)</gcds-text>

<fdcp-code code-language="json">{
  "FoundationComponentsSettings": {
    "GlobalCssFiles": [
      "/css/custom-styles.css",
      "https://cdn.jsdelivr.net/npm/some-other-library@1.0.0/dist/style.css"
    ],
    "GlobalJavaScriptFiles": [
      "/js/custom-scripts.js",
      "https://cdn.jsdelivr.net/npm/some-other-library@1.0.0/dist/script.js"
    ],
    "GlobalMetaTags": [
      {
        "name": "description",
        "content": "Fallback or language-neutral text",
        "contentEn": "My application description (English)",
        "contentFr": "Description de mon application (français)"
      },
      { "property": "og:title", "content": "My Application" }
    ],
    "GlobalLinkTags": [
      "&lt;link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"&gt;"
    ]
  }
}</fdcp-code>
</section>

<section>
    <gcds-heading tag="h2">@Installation.GlobalResources_UsingHelper_Title</gcds-heading>
    <gcds-text>@Html.Raw(Installation.GlobalResources_UsingHelper_Description)</gcds-text>

<fdcp-code code-language="cshtml">@@inject GlobalResourceHelper ResourceHelper

@@* Render all global CSS files *@@
@@Html.Raw(ResourceHelper.RenderGlobalCssFiles())

@@* Render all global JavaScript files *@@
@@Html.Raw(ResourceHelper.RenderGlobalJavaScriptFiles())

@@* Check if specific resources should be included *@@
@@if (ResourceHelper.ShouldIncludeGCDSResources())
{
    &lt;link rel="stylesheet" href="/css/gcds-override.css" /&gt;
}</fdcp-code>
</section>

@section Scripts {
    @{
        var nonce = CspNonceHelper.AddNonceToDirective(Context, GCFoundation.Components.Helpers.DirectiveType.Script);
    }
    <script nonce="@nonce">
        // This script will be loaded on this page only
        console.log('Global Resources Demo Page Loaded');
        
        // You can also check if global resources are available
        if (typeof someOtherLibrary !== 'undefined') {
            console.log('Some other library is available from global configuration');
        }
        
        // Default foundation resources are always available
        console.log('Default GCFoundation resources are always loaded');
    </script>
} 