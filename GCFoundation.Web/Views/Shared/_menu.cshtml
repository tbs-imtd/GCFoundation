@using GCFoundation.Common.Settings
@using GCFoundation.Web.Resources
@using Microsoft.Extensions.Options
@inject IOptions<GCFoundationComponentsSettings> settings

<gcds-top-nav label="@settings.Value.ApplicationName" alignment="end">
    <gcds-nav-link href="@Url.Action("Index","Home")" slot="home">@settings.Value.ApplicationName</gcds-nav-link>
    
    <gcds-nav-group open-trigger="@Menu.Menu_GetStarted" menu-label="@Menu.Menu_GetStarted">
        <gcds-nav-link href="@Url.Action("Index", "Installation")">@Menu.Menu_Installation</gcds-nav-link>
        <gcds-nav-link href="@Url.Action("DateModified", "Installation")">@Menu.Menu_Installation_DateModified</gcds-nav-link>
        <gcds-nav-link href="@Url.Action("GlobalResources", "Installation")">@Menu.Menu_Installation_GlobalResources</gcds-nav-link>
        <gcds-nav-link href="@Url.Action("Metadata", "Installation")">@Menu.Menu_Installation_Metadata</gcds-nav-link>
        <gcds-nav-link href="@Url.Action("Translations", "Installation")">@Menu.Menu_Installation_Translations</gcds-nav-link>
    </gcds-nav-group>
    <gcds-nav-link href="@Url.Action("Index","Template")">@Menu.Menu_Template</gcds-nav-link>
    <gcds-nav-group open-trigger="@Menu.Menu_Components" menu-label="@Menu.Menu_Components">
        <gcds-nav-link href="@Url.Action("gcds","Components")">@Menu.Menu_Components_GCDesign</gcds-nav-link>
        <gcds-nav-link href="@Url.Action("Index","Components")">@Menu.Menu_Components_FDCP</gcds-nav-link>
    </gcds-nav-group>
</gcds-top-nav>