@using GCFoundation.Web.Resources

<fdcp-tabs id="modal-basic-tabs" label="@Components.Modal_Variants_Label">
    <fdcp-tab id="modal-tab-default" title="@Components.Modal_Default_Title" active="true">
        <gcds-text>@Html.Raw(Components.Modal_Default_Text)</gcds-text>

        <gcds-button button-id="default-modal-button" button-role="primary" modal-id="default-modal" class="fdcp-modal-open">@Components.Modal_Default_OpenButton</gcds-button>
        <fdcp-modal state="regular" modal-id="default-modal" title="@Components.Modal_Default_ModalTitle">
            <div slot="body">
                <gcds-text>@Components.Modal_Default_Body</gcds-text>
            </div>
            <div slot="footer">
                <gcds-button button-id="default-modal-confirm" button-role="primary" class="fdcp-modal-close">@Components.Modal_Sample_Confirm</gcds-button>
                <gcds-button button-id="default-modal-back" button-role="secondary" class="fdcp-modal-close">@Components.Modal_Sample_Back</gcds-button>
            </div>
        </fdcp-modal>

        <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-modal state=""regular"" modal-id=""default-modal"" title=""{Html.Encode(Components.Modal_Default_ModalTitle)}""&gt;
    ...
    &lt;div slot=""footer""&gt;
        &lt;gcds-button button-id=""info-modal-confirm"" button-role=""primary"" class=""fdcp-modal-close""&gt;{Html.Encode(Components.Modal_Sample_Confirm)}&lt;/gcds-button&gt;
        &lt;gcds-button button-id=""info-modal-back"" button-role=""secondary"" class=""fdcp-modal-close""&gt;{Html.Encode(Components.Modal_Sample_Back)}&lt;/gcds-button&gt;
    &lt;/div&gt;
&lt;/fdcp-modal&gt;")</code></pre>
    </fdcp-tab>

    <fdcp-tab id="modal-tab-info" title="@Components.Modal_Info_Title">
        <gcds-text>@Components.Modal_Info_Text</gcds-text>

        <gcds-button button-id="info-modal-button" button-role="primary" modal-id="info-modal" class="fdcp-modal-open">@Components.Modal_Info_OpenButton</gcds-button>
        <fdcp-modal state="info" modal-id="info-modal" title="@Components.Modal_Info_ModalTitle">
            <div slot="body">
                <gcds-text>@Components.Modal_Info_Body</gcds-text>
            </div>
            <div slot="footer">
                <gcds-button button-id="info-modal-back" button-role="secondary" class="fdcp-modal-close">@Components.Modal_Sample_Back</gcds-button>
            </div>
        </fdcp-modal>

        <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-modal state=""info"" modal-id=""info-modal"" title=""{Html.Encode(Components.Modal_Info_ModalTitle)}""&gt;
    ...
    &lt;div slot=""footer""&gt;
        &lt;gcds-button button-id=""info-modal-back"" button-role=""secondary"" class=""fdcp-modal-close""&gt;{Html.Encode(Components.Modal_Sample_Back)}&lt;/gcds-button&gt;
    &lt;/div&gt;
&lt;/fdcp-modal&gt;")</code></pre>
    </fdcp-tab>

    <fdcp-tab id="modal-tab-warning" title="@Components.Modal_Warning_Title">
        <gcds-text>@Components.Modal_Warning_Text</gcds-text>

        <gcds-button button-id="warning-modal-button" button-role="primary" modal-id="warning-modal" class="fdcp-modal-open">@Components.Modal_Warning_OpenButton</gcds-button>
        <fdcp-modal state="warning" modal-id="warning-modal" title="@Components.Modal_Warning_ModalTitle">
            <div slot="body">
                <gcds-text>@Components.Modal_Warning_Body</gcds-text>
            </div>
            <div slot="footer">
                <gcds-button button-id="warning-modal-confirm" button-role="danger" class="fdcp-modal-close">@Components.Modal_Sample_Confirm</gcds-button>
                <gcds-button button-id="warning-modal-back" button-role="secondary" class="fdcp-modal-close">@Components.Modal_Sample_Back</gcds-button>
            </div>
        </fdcp-modal>

        <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-modal state=""warning"" modal-id=""warning-modal"" title=""{Html.Encode(Components.Modal_Warning_ModalTitle)}""&gt;
    ...
    &lt;div slot=""footer""&gt;
        &lt;gcds-button button-id=""warning-modal-confirm"" button-role=""danger"" class=""fdcp-modal-close""&gt;{Html.Encode(Components.Modal_Sample_Confirm)}&lt;/gcds-button&gt;
        &lt;gcds-button button-id=""warning-modal-back"" button-role=""secondary"" class=""fdcp-modal-close""&gt;{Html.Encode(Components.Modal_Sample_Back)}&lt;/gcds-button&gt;
    &lt;/div&gt;
&lt;/fdcp-modal&gt;")</code></pre>
    </fdcp-tab>
</fdcp-tabs>
