@using GCFoundation.Components.Helpers
@model GCFoundation.Web.Models.Components.ComponentSampleCodeSectionViewModel

<fdcp-card horizontal="true" image-top="@Url.Content("~/images/preview-card-horizontal.svg")" image-alt="Horizontal card image">
    <h5 class="fdcp-card-title">Card title</h5>
    <p class="fdcp-card-text">This is a wider card with supporting text below as a natural lead-in to additional content. This content is a little bit longer.</p>
