@using GCFoundation.Web.Resources
@model GCFoundation.Web.Models.Components.ComponentViewModel

@* Additional guidance sections *@
@if (Model.GuidanceSections != null && Model.GuidanceSections.Any())
{
    @foreach (var guidanceSection in Model.GuidanceSections)
    {
        <gcds-heading tag="h2" id="@guidanceSection.Id">@guidanceSection.Title</gcds-heading>
        @if (!string.IsNullOrEmpty(guidanceSection.Description))
        {
            @Html.Raw(guidanceSection.Description)
        }

        <partial name="@guidanceSection.PartialViewName" model="guidanceSection" />
    }
}
