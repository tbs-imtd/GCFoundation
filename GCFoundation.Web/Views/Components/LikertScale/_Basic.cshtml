@using GCFoundation.Web.Models.Components
@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Mvc.Rendering
@model LikertScaleModel

@{
    var satisfactionOptions = new List<SelectListItem>
    {
        new() { Text = Components.LikertScale_Basic_VeryDissatisfied, Value = "very-dissatisfied" },
        new() { Text = Components.LikertScale_Basic_Dissatisfied, Value = "dissatisfied" },
        new() { Text = Components.LikertScale_Basic_Satisfied, Value = "satisfied" },
        new() { Text = Components.LikertScale_Basic_VerySatisfied, Value = "very-satisfied" }
    };
}

<fdcp-likert-scale for="@Model.ServiceSatisfaction"
                        items="@satisfactionOptions"
                        index="@Components.LikertScale_Basic_Index"/>

<fdcp-code code-language="cshtml">@Html.Raw($@"@using GCFoundation.Web.Models.Components
@using Microsoft.AspNetCore.Mvc.Rendering
@model LikertScaleModel

@{{
    var satisfactionOptions = new List&lt;SelectListItem&gt;
    {{
        new() {{ Text = ""{Html.Encode(Components.LikertScale_Basic_VeryDissatisfied)}"", Value = ""very-dissatisfied"" }},
        new() {{ Text = ""{Html.Encode(Components.LikertScale_Basic_Dissatisfied)}"", Value = ""dissatisfied"" }},
        new() {{ Text = ""{Html.Encode(Components.LikertScale_Basic_Satisfied)}"", Value = ""satisfied"" }},
        new() {{ Text = ""{Html.Encode(Components.LikertScale_Basic_VerySatisfied)}"", Value = ""very-satisfied"" }}
    }};
}}

&lt;fdcp-likert-scale for=""@Model.ServiceSatisfaction""
                        items=""@satisfactionOptions""
                        index=""{Html.Encode(Components.LikertScale_Basic_Index)}"" /&gt;")</fdcp-code>

<fdcp-code code-language="csharp">@Html.Raw(Html.Encode(@"using System.ComponentModel.DataAnnotations;

public class LikertScaleModel : ComponentViewModel
{
    [Required]
    [Display(Name = ""LikertScale_Basic_Legend"", Description = ""LikertScale_Basic_Hint"", ResourceType = typeof(Resources.Components))]
    public string ServiceSatisfaction { get; set; } = string.Empty;
}"))</fdcp-code>
