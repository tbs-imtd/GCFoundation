@using GCFoundation.Components.Models

<fdcp-stepper current-step="2"
              heading-tag="h3"
              steps="@(new List<StepperStep>
                                {
                                    new StepperStep { StepNumber = 1, Label = "Back", IsLink = true, LinkUrl = "#step1" },
                                    new StepperStep { StepNumber = 2, Label = "Current" },
                                    new StepperStep { StepNumber = 3, Label = "Next" }
                                })"></fdcp-stepper>
