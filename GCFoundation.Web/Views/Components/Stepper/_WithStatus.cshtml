@using GCFoundation.Components.Enums
@using GCFoundation.Components.Models

<fdcp-stepper current-step="3"
              heading-tag="h3"
              steps="@(new List<StepperStep>
                                {
                                    new StepperStep { StepNumber = 1, Label = "Step 1", DisplayMode = StepperStepDisplayMode.Icon, StatusBadgeLabel = "Done", StatusBadgeStyle = BadgeStyle.secondary, StatusBadgeStyleInverted = false, CompletedIconHtml = "<i class='fa fa-check'></i>" },
                                    new StepperStep { StepNumber = 2, Label = "Step 2", DisplayMode = StepperStepDisplayMode.Icon, StatusBadgeLabel = "<span class=\"visibility-sr-only\">This step is</span> Not required <span class=\"visibility-sr-only\">based on your previous answers.</span>", StatusBadgeStyle = BadgeStyle.secondary, StatusBadgeStyleInverted = true, CompletedIconHtml = "<i class='fa-solid fa-xmark'></i>" },
                                    new StepperStep { StepNumber = 3, Label = "Step 3", DisplayMode = StepperStepDisplayMode.Icon, InProgressIconHtml = "<i class='fa fa-spinner'></i>" },
                                    new StepperStep { StepNumber = 4, Label = "Step 4", DisplayMode = StepperStepDisplayMode.Icon }
                                })"></fdcp-stepper>
