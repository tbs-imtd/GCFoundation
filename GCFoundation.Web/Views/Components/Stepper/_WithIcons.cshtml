@using GCFoundation.Components.Enums
@using GCFoundation.Components.Models

<fdcp-stepper current-step="2"
              heading-tag="h3"
              steps="@(new List<StepperStep>
                                {
                                    new StepperStep { StepNumber = 1, Label = "Complete", DisplayMode = StepperStepDisplayMode.Icon, CompletedIconHtml = "<i class='fa fa-check'></i>" },
                                    new StepperStep { StepNumber = 2, Label = "In Progress", DisplayMode = StepperStepDisplayMode.Icon, InProgressIconHtml = "<i class='fa fa-spinner'></i>" },
                                    new StepperStep { StepNumber = 3, Label = "Not Started", DisplayMode = StepperStepDisplayMode.Icon }
                                })"></fdcp-stepper>
<fdcp-code code-language="cshtml">
&lt;fdcp-stepper current-step="2"
    heading-tag="h3"
    steps="@@(new List&lt;StepperStep&gt;
          {
              new StepperStep { StepNumber = 1, Label = "Complete", DisplayMode = StepperStepDisplayMode.Icon, CompletedIconHtml = "&lt;i class='fa fa-check'&gt;&lt;/i&gt;" },
              new StepperStep { StepNumber = 2, Label = "In Progress", DisplayMode = StepperStepDisplayMode.Icon, InProgressIconHtml = "&lt;i class='fa fa-spinner'&gt;&lt;/i&gt;" },
              new StepperStep { StepNumber = 3, Label = "Not Started", DisplayMode = StepperStepDisplayMode.Icon }
          })"&gt;&lt;/fdcp-stepper&gt;
</fdcp-code>