&lt;fdcp-stepper current-step="2"
    heading-tag="h3"
    steps="@@(new List&lt;StepperStep&gt;
          {
              new StepperStep { StepNumber = 1, Label = "Step One", DisplayMode = StepperStepDisplayMode.Number },
              new StepperStep { StepNumber = 2, Label = "Step Two", DisplayMode = StepperStepDisplayMode.Number },
              new StepperStep { StepNumber = 3, Label = "Step Three", DisplayMode = StepperStepDisplayMode.Number }
          })"&gt;&lt;/fdcp-stepper&gt;
</fdcp-code>