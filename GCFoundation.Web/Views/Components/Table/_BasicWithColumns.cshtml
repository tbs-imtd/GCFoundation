@using GCFoundation.Components.Models.TableBuilder
@using GCFoundation.Web.Models.Table
@using GCFoundation.Web.Resources

@{
    var cols = new List<ColumnDefinition>
    {
        new() { Field = "submissionId", Header = Components.Table_Submission_Id_Header, RowHeader = true },
        new() { Field = "submitterName", Header = Components.Table_Submitter_Name_Header },
        new() { Field = "dateSubmitted", Header = Components.Table_Date_Submitted_Header, Sort = true },
        new() { Field = "assignedReviewer", Header = Components.Table_Assigned_Reviewer_Header },
    };
    var rows = new List<TableRowBasicTestViewModel>
    {
        new() { SubmissionId = "001", SubmitterName = "Alice Tremblay",  DateSubmitted = new DateTime(2025, 3, 10,  9,  0, 0), AssignedReviewer = "Bob Martin"     },
        new() { SubmissionId = "002", SubmitterName = "Jean Dupont",     DateSubmitted = new DateTime(2025, 3, 11, 14, 30, 0), AssignedReviewer = "Alice Tremblay" },
        new() { SubmissionId = "003", SubmitterName = "Sarah Lee",       DateSubmitted = new DateTime(2025, 3, 12, 10, 15, 0), AssignedReviewer = "Bob Martin"     },
    };
}

<fdcp-table caption="@Components.Table_WithColumns_Caption" column-definitions="@cols" rows="@rows"></fdcp-table>
<fdcp-code code-language="cshtml">@Html.Raw($@"&lt;fdcp-table caption=""{Html.Encode(Components.Table_WithColumns_Caption)}""
            column-definitions=""@Model.Cols""
            rows=""@Model.Rows""&gt;
&lt;/fdcp-table&gt;")</fdcp-code>
<fdcp-code code-language="csharp">@Html.Raw(Html.Encode(@"using GCFoundation.Components.Models.Table;

vm.Cols = new List<ColumnDefinition>()
{
    new() { Field = ""submissionId"", Header = Resources.Components.Table_Submission_Id_Header, RowHeader = true },
    new() { Field = ""submitterName"", Header = Resources.Components.Table_Submitter_Name_Header },
    new() { Field = ""dateSubmitted"", Header = Resources.Components.Table_Date_Submitted_Header, Sort = true },
    new() { Field = ""assignedReviewer"", Header = Resources.Components.Table_Assigned_Reviewer_Header },
};
vm.Rows = new List<MyRowViewModel>() { ... };
    "))</fdcp-code>