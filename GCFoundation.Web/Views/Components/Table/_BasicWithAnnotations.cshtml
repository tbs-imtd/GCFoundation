@using GCFoundation.Web.Models.Table
@using GCFoundation.Web.Resources

@{
    var rows = new List<TableRowBasicTestViewModel>
    {
        new() { SubmissionId = "001", SubmitterName = "Alice Tremblay",  DateSubmitted = new DateTime(2025, 3, 10,  9,  0, 0), AssignedReviewer = "Bob Martin"     },
        new() { SubmissionId = "002", SubmitterName = "Jean Dupont",     DateSubmitted = new DateTime(2025, 3, 11, 14, 30, 0), AssignedReviewer = "Alice Tremblay" },
        new() { SubmissionId = "003", SubmitterName = "Sarah Lee",       DateSubmitted = new DateTime(2025, 3, 12, 10, 15, 0), AssignedReviewer = "Bob Martin"     },
    };
}

<fdcp-table sort filter caption="@Components.Table_WithAnnotations_Caption" rows="@rows"></fdcp-table>

<div class="code-container">
    <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-table sort filter caption=""{Html.Encode(Components.Table_WithAnnotations_Caption)}"" rows=""@Model.Rows""&gt;&lt;/fdcp-table&gt;")</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
</div>
<div class="code-container">
    <pre><code class="language-csharp">@Html.Raw(Html.Encode(@"public class MyRowViewModel
        {
            public string SubmissionId { get; set; }

            [TableColumnDefinition(Name = ""Table_Submitter_Name_Header"",
                                   ResourceType = typeof(Resources.Components),
                                   RowHeader = true)]
            public string SubmitterName { get; set; }

            [DateFormat(""yyyy-MM-dd HH:mm"")]
            [TableColumnDefinition(Name = ""Table_Date_Submitted_Header"",
                                   ResourceType = typeof(Resources.Components),
                                   Sort = true)]
            public DateTime DateSubmitted { get; set; }

            [TableColumnDefinition(Name = ""Table_Assigned_Reviewer_Header"",
                                   ResourceType = typeof(Resources.Components))]
            public string AssignedReviewer { get; set; }
        }
        "))</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
</div>