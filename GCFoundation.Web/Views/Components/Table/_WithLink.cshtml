@using GCFoundation.Web.Models.Table
@using GCFoundation.Web.Resources

@{
    var rows = new List<TableRowLinkTestViewModel>
    {
        new() { SubmissionId = "001", SubmitterName = "Alice Tremblay",  DateSubmitted = new DateTime(2025, 3, 10,  9,  0, 0), AssignedReviewer = "Bob Martin",     SubmissionLink = Components.Table_WithLink_Label },
        new() { SubmissionId = "002", SubmitterName = "Jean Dupont",     DateSubmitted = new DateTime(2025, 3, 11, 14, 30, 0), AssignedReviewer = "Alice Tremblay", SubmissionLink = Components.Table_WithLink_Label },
        new() { SubmissionId = "003", SubmitterName = "Sarah Lee",       DateSubmitted = new DateTime(2025, 3, 12, 10, 15, 0), AssignedReviewer = "Bob Martin",     SubmissionLink = Components.Table_WithLink_Label },
    };
}

<fdcp-table caption="@Components.Table_WithLink_Caption" rows="@rows">
    <template slot="cell:submissionLink">
        <gcds-link data-bind-template="@Components.Table_WithLink_Label {submitterName}" href="#@Components.Table_WithLink_Anchor"></gcds-link>
    </template>
</fdcp-table>

<gcds-text class="mt-200">@Html.Raw(@Components.Table_WithLink_Note)</gcds-text>

<div class="code-container">
    <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-table caption=""{Html.Encode(Components.Table_WithLink_Caption)}"" rows=""@Model.Rows""&gt;
    &lt;template slot=""cell:submissionLink""&gt;
        &lt;gcds-link data-bind-template=""{Html.Encode(Components.Table_WithLink_Label)} {{submitterName}}""
                   href=""#{Html.Encode(Components.Table_WithLink_Anchor)}""&gt;&lt;/gcds-link&gt;
    &lt;/template&gt;
&lt;/fdcp-table&gt;")</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
</div>
<div class="code-container">
    <pre><code class="language-csharp">@Html.Raw(Html.Encode(@"[TableColumnDefinition(Name = ""Table_Submitter_Name_Header"",
                       ResourceType = typeof(Resources.Components),
                       RowHeader = true)]
public string SubmitterName { get; set; } = string.Empty;

[TableColumnDefinition(Name = ""Table_Link_Header"",
                       ResourceType = typeof(Resources.Components),
                       Slotted = true)]
public string SubmissionLink { get; set; } = string.Empty;
"))</code><gcds-button button-role="secondary" class="mt-150 code-copy-button" data-success-text="@Components.Shared_CopyButton_SuccessText">@Components.Shared_CopyButton_Text</gcds-button></pre>
</div>