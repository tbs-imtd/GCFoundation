@using GCFoundation.Web.Models.Table
@using GCFoundation.Web.Resources

@{
    var rows = new List<TableRowButtonLinkTestViewModel>
    {
        new() { SubmissionId = "001", SubmitterName = "Alice Tremblay",  DateSubmitted = new DateTime(2025, 3, 10,  9,  0, 0), AssignedReviewer = "Bob Martin",     Action = Components.Table_WithButtonLink_Label },
        new() { SubmissionId = "002", SubmitterName = "Jean Dupont",     DateSubmitted = new DateTime(2025, 3, 11, 14, 30, 0), AssignedReviewer = "Alice Tremblay", Action = Components.Table_WithButtonLink_Label },
        new() { SubmissionId = "003", SubmitterName = "Sarah Lee",       DateSubmitted = new DateTime(2025, 3, 12, 10, 15, 0), AssignedReviewer = "Bob Martin",     Action = Components.Table_WithButtonLink_Label },
    };
}

<fdcp-table caption="@Components.Table_WithButtonLink_Caption" rows="@rows">
    <template slot="cell:action">
        <gcds-button type="link" href="#@Components.Table_WithButtonLink_Anchor" size="small">@Components.Table_WithButtonLink_Label</gcds-button>
    </template>
</fdcp-table>

<gcds-text class="mt-200">@Html.Raw(@Components.Table_WithButtonLink_Note)</gcds-text>

<div class="code-container">
    <pre><code class="language-cshtml">@Html.Raw($@"&lt;fdcp-table caption=""{Html.Encode(Components.Table_WithButtonLink_Caption)}"" rows=""@Model.Rows""&gt;
    &lt;template slot=""cell:action""&gt;
        &lt;gcds-button type=""link""
                     href=""#{Html.Encode(Components.Table_WithButtonLink_Anchor)}""
                     size=""small""&gt;{Html.Encode(Components.Table_WithButtonLink_Label)}&lt;/gcds-button&gt;
    &lt;/template&gt;
&lt;/fdcp-table&gt;")</code></pre>
</div>
<div class="code-container">
    <pre><code class="language-csharp">@Html.Raw(Html.Encode(@"[TableColumnDefinition(Name = ""Table_Actions_Header"",
                       ResourceType = typeof(Resources.Components),
                       Slotted = true)]
public string Action { get; set; }
"))</code></pre>
</div>