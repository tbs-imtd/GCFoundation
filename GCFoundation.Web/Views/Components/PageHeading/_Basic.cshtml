@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<p>
    <gcds-button button-role="secondary" type="link" target="_blank" rel="noopener noreferrer" href="@Url.Action("PageHeadingDemo", "Components")">@Template.Demo_Button <i class="ms-100 fa-solid fa-desktop"></i></gcds-button>
</p>
<gcds-heading tag="h3">@Template.Preview</gcds-heading>
<img src="@Url.Content($"~/images/page-heading/regular-{Localization.ThreeLetterLanguage}.jpg")" alt="@Components.PageHeading_Image_Regular_AltText" class="img-responsive" />
<fdcp-code code-language="html">@Html.Raw($@"&lt;fdcp-page-heading
    title=""{Html.Encode(Components.PageHeading_Demo_Title)}""
    description=""{Html.Encode(Components.PageHeading_Demo_Description)}""
    src=""/images/page-heading-bg.jpg""
    text-emphasis=""true"" /&gt;")</fdcp-code>
