@using GCFoundation.Components.Resources
@using GCFoundation.Web.Resources

<fdcp-tabs id="page-heading-colour-tabs" label="@Components.PageHeading_Colour_Label">
    <fdcp-tab id="page-heading-tab-colour-light" title="@Components.PageHeading_Colour_Light_Title" active="true">
        <gcds-text>@Html.Raw(Components.PageHeading_Colour_Light_Text)</gcds-text>
        <img src="@Url.Content($"~/images/page-heading/regular-{Localization.ThreeLetterLanguage}.jpg")" alt="@Components.PageHeading_Image_Regular_AltText" class="img-responsive" />
        <fdcp-code code-language="html">@Html.Raw($@"&lt;fdcp-page-heading
    title=""{Html.Encode(Components.PageHeading_Demo_Title)}""
    description=""{Html.Encode(Components.PageHeading_Demo_Description)}""
    src=""/images/page-heading-bg.jpg""
    text-emphasis=""true""
    text-colour=""light""
    background-colour=""primary"" /&gt;")</fdcp-code>
    </fdcp-tab>

    <fdcp-tab id="page-heading-tab-colour-primary" title="@Components.PageHeading_Colour_Primary_Title">
        <gcds-text>@Html.Raw(Components.PageHeading_Colour_Primary_Text)</gcds-text>
        <img src="@Url.Content($"~/images/page-heading/light-{Localization.ThreeLetterLanguage}.jpg")" alt="@Components.PageHeading_Image_Light_AltText" class="img-responsive" />
        <fdcp-code code-language="html">@Html.Raw($@"&lt;fdcp-page-heading
    title=""{Html.Encode(Components.PageHeading_Demo_Title)}""
    description=""{Html.Encode(Components.PageHeading_Demo_Description)}""
    src=""/images/page-heading-bg.jpg""
    text-emphasis=""true""
    text-colour=""primary""
    background-colour=""light"" /&gt;")</fdcp-code>
    </fdcp-tab>
</fdcp-tabs>
