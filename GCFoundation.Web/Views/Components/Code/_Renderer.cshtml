@using GCFoundation.Web.Models.Components
@model ComponentSampleCodeSectionViewModel

<fdcp-code-block language="csharp">
    using GCFoundation.Components.Helpers;
    using GCFoundation.Components.Models.Code;

    IHtmlContent html = FDCPCodeRenderer.Render(new CodeBlockOptions
    {
        Id = "create-request-example",
        Title = "Create a request",
        SyncGroup = "request-examples",
        Samples =
        [
            new CodeSample { Language = "csharp", Code = csharpSource },
            new CodeSample { Language = "python", Code = pythonSource }
        ]
    });

    // A JSON block placed under an existing heading: name it without adding a visible title.
    IHtmlContent schema = FDCPCodeRenderer.Render(new CodeBlockOptions
    {
        AccessibleLabel = "GET /requests/{id} — Schema",
        Samples = [new CodeSample { Language = "json", Code = schemaJson }]
    });
</fdcp-code-block>
