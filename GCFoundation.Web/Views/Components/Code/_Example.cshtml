@using GCFoundation.Web.Models.Components
@using GCFoundation.Web.Resources
@model ComponentSampleCodeSectionViewModel

<fdcp-code id="code-example-create" title="@Components.Code_SampleCreateTitle"
                   examples="@CodeDemoSamples.CreateRequest" selected-code-language="csharp"
                   sync-group="@CodeDemoSamples.RequestSyncGroup" />

<fdcp-code id="code-example-read" title="@Components.Code_SampleReadTitle"
                   examples="@CodeDemoSamples.ReadRequest"
                   sync-group="@CodeDemoSamples.RequestSyncGroup" />

<fdcp-code code-language="cshtml">
    @@{
        var createExamples = new List&lt;CodeSample&gt;
        {
            new() { Language = "csharp", Code = Model.CreateCSharp },
            new() { Language = "javascript", Code = Model.CreateJavaScript },
            new() { Language = "python", Code = Model.CreatePython }
        };
    }

    &lt;fdcp-code id="code-example-create"
                       title="@Components.Code_SampleCreateTitle"
                       examples="@@createExamples"
                       selected-code-language="csharp"
                       sync-group="@CodeDemoSamples.RequestSyncGroup" /&gt;

    &lt;fdcp-code id="code-example-read"
                       title="@Components.Code_SampleReadTitle"
                       examples="@@Model.ReadExamples"
                       sync-group="@CodeDemoSamples.RequestSyncGroup" /&gt;
</fdcp-code>
