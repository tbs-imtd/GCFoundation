@using GCFoundation.Web.Models.Components
@using GCFoundation.Web.Resources
@model ComponentSampleCodeSectionViewModel

<fdcp-code-block id="code-block-response" title="@Components.Code_SampleResponseTitle" language="json" code="@CodeDemoSamples.ResponseJson" />

<fdcp-code-block id="code-block-registration" title="@Components.Code_SampleRegistrationTitle" language="csharp">
    builder.Services.AddGCFoundationComponents(builder.Configuration);
    builder.Services.AddGCFoundationContentPolicies(builder.Configuration);

    var app = builder.Build();
    app.UseGCFoundationComponents();
</fdcp-code-block>

<fdcp-code-block language="cshtml">
    &lt;fdcp-code-block id="code-block-response"
                     title="@Components.Code_SampleResponseTitle"
                     language="json"
                     code="@@Model.ResponseJson" /&gt;

    &lt;fdcp-code-block id="code-block-registration"
                     title="@Components.Code_SampleRegistrationTitle"
                     language="csharp"&gt;
        builder.Services.AddGCFoundationComponents(builder.Configuration);
        builder.Services.AddGCFoundationContentPolicies(builder.Configuration);

        var app = builder.Build();
        app.UseGCFoundationComponents();
    &lt;/fdcp-code-block&gt;
</fdcp-code-block>
