@using GCFoundation.Web.Models.Components
@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Mvc.Rendering
@model ComponentsIndexPageViewModel

@{
    List<SelectListItem> radioOptions =
    [
        new() { Text = "It doesn’t apply to my role", Value = "not-applicable" },
        new() { Text = "I just started learning about it", Value = "learning" },
        new() { Text = "I can do it with guidance", Value = "guidance" },
        new() { Text = "I can do it without guidance", Value = "independent" },
        new() { Text = "I can help, support, or guide others", Value = "support-others" }
    ];
}

<gcds-heading tag="h1">@Components.Index_Page_Title</gcds-heading>
<gcds-heading tag="h2">@Components.Index_FeaturedComponents_Title</gcds-heading>

<gcds-grid columns="1fr" columns-desktop="repeat(3, 1fr)" columns-tablet="repeat(2, 1fr)" equal-row-height>
@foreach (var component in Model.FeaturedComponents.OrderBy(c => c.Name))
{
    <gcds-card  badge="@(component.IsNew == true ? Components.Card_Badge_New : null)"
                card-title="@component.Name"
                description="@component.ShortDescription"
                href="@component.Href"
                img-alt="@string.Format(Components.Index_Card_ImgAlt_Template, component.Name)"
                img-src="@component.ImgSrc">
        @Html.Raw(component.Description)
    </gcds-card>
}
</gcds-grid>

<gcds-heading tag="h2" margin-bottom="300">@Components.Index_TagHelpers_Section_Title</gcds-heading>
<gcds-text margin-bottom="300">@Components.Index_TagHelpers_Section_Description</gcds-text>

@foreach (var tagHelperGroup in Model.TagHelperGroups)
{
    <gcds-heading tag="h3" margin-bottom="200">@tagHelperGroup.Title</gcds-heading>

    <fdcp-accordion accordion-id="@tagHelperGroup.Title.ToLower().Replace(" ", "-")-accordion" always-open="true">
    @foreach (var tagHelperReference in tagHelperGroup.Items.OrderBy(t => t.Title))
    {
        <gcds-details details-title="@tagHelperReference.Title">
            <gcds-text margin-bottom="100">@tagHelperReference.Description</gcds-text>
            @if (tagHelperReference.KeyProperties != null && tagHelperReference.KeyProperties.Count > 0)
            {
                <gcds-text margin-bottom="100">
                    <strong>@Components.Index_TagHelpers_KeyProperties_Label:</strong>
                    @string.Join(", ", tagHelperReference.KeyProperties)
                </gcds-text>
            }
            @if (!string.IsNullOrWhiteSpace(tagHelperReference.UsageSnippet))
            {
                <pre><code class="language-cshtml">@Html.Raw(Html.Encode(tagHelperReference.UsageSnippet))</code></pre>
            }
        </gcds-details>
    }
    </fdcp-accordion>
}

<fdcp-horizontal-radios class="mt-400"
                        items="@radioOptions"
                        name="collaboration-frequency"
                        legend="1.3 Collaboration using digital tools"
                        hint="I use note-taking applications such as OneNote, transcription services, and collaborative platforms like GCXchange, GCconnex, GCcollab, GCwiki and Microsoft Teams to make communication, collaboration and documentation easier and more effective."
                        required="true" />
