                &lt;th scope="col"&gt;@colDepartment&lt;/th&gt;
                &lt;th scope="col"&gt;@colStatus&lt;/th&gt;
            &lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
            &lt;tr&gt;
                &lt;th scope="row"&gt;1&lt;/th&gt;
                &lt;td&gt;@(isFr ? "Jean Dupont" : "Jane Doe")&lt;/td&gt;
                &lt;td&gt;@(isFr ? "Finances" : "Finance")&lt;/td&gt;
                &lt;td&gt;@(isFr ? "Actif" : "Active")&lt;/td&gt;
            &lt;/tr&gt;
        &lt;/tbody&gt;
    &lt;/table&gt;
    &lt;p id="table-basic-summary" class="visibility-sr-only"&gt;@Components.Table_Basic_Summary&lt;/p&gt;
&lt;/div&gt;</code></pre>
