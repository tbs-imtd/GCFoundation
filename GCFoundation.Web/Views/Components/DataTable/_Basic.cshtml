@using GCFoundation.Web.Resources
@using System.Globalization
@model GCFoundation.Web.Models.Components.ComponentSampleCodeSectionViewModel

@{
    var isFr = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "fr", StringComparison.OrdinalIgnoreCase);
    var colName = isFr ? "Nom" : "Name";
    var colDepartment = isFr ? "Département" : "Department";
    var colStatus = isFr ? "Statut" : "Status";
}

<div class="fdcp-table-responsive">
    <table class="fdcp-table fdcp-table-hover fdcp-table-striped"
           aria-describedby="table-basic-summary">
        <caption>@Components.Table_Basic_Caption</caption>
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">@colName</th>
                <th scope="col">@colDepartment</th>
                <th scope="col">@colStatus</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row">1</th>
                <td>@(isFr ? "Jean Dupont" : "Jane Doe")</td>
                <td>@(isFr ? "Finances" : "Finance")</td>
                <td>@(isFr ? "Actif" : "Active")</td>
            </tr>
            <tr>
                <th scope="row">2</th>
                <td>@(isFr ? "Marie Tremblay" : "John Smith")</td>
                <td>@(isFr ? "Ressources humaines" : "Human Resources")</td>
                <td>@(isFr ? "En attente" : "Pending")</td>
            </tr>
            <tr>
                <th scope="row">3</th>
                <td>@(isFr ? "Alex Martin" : "Alex Martin")</td>
                <td>@(isFr ? "Technologie de l'information" : "Information Technology")</td>
                <td>@(isFr ? "Actif" : "Active")</td>
            </tr>
        </tbody>
    </table>
    <p id="table-basic-summary" class="visibility-sr-only">@Components.Table_Basic_Summary</p>
</div>

<pre><code class="language-html">&lt;div class="fdcp-table-responsive"&gt;
    &lt;table class="fdcp-table fdcp-table-hover fdcp-table-striped"
           aria-describedby="table-basic-summary"&gt;
