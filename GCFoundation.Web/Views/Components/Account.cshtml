@using GCFoundation.Components.Helpers
@using GCFoundation.Components.Models
@using GCFoundation.Components.Services
@using GCFoundation.Components.Settings
@using Microsoft.Extensions.Options
@inject AccountService AccountService
@inject IOptions<GCFoundationAccountSettings> AccountSettings

@using GCFoundation.Web.Resources
@{
    ViewData["Title"] = Components.Account_Component_Title;
    string styleNonce = CspNonceHelper.AddNonceToDirective(Context, DirectiveType.Style);
}

<gcds-container size="xl" alignment="center">
    <gcds-grid columns="1fr">
        <div>
            <gcds-heading tag="h1">@Components.Account_Component_Title</gcds-heading>
            <gcds-text>
                @Components.Account_Component_Description
            </gcds-text>
        </div>
    </gcds-grid>

    <!-- Live Examples Section -->
    <gcds-grid columns="1fr" class="mt-400">
        <div>
            <gcds-heading tag="h2">@Components.Account_LiveExamples</gcds-heading>
            <gcds-text>
                @Components.Account_LiveExamples_Description
            </gcds-text>
        </div>
    </gcds-grid>

    <!-- Live Example with Actual Authentication State -->
    <gcds-grid columns="1fr" class="mt-300">
        <div>
            <gcds-heading tag="h3" size="h4" >@Components.Account_CurrentUserState</gcds-heading>
            <gcds-text class="mb-200">
                @Components.Account_CurrentUserState_Description
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <span>@Html.Raw(Components.Account_CurrentlyAuthenticated)</span>
                }
                else
                {
                    <span>@Html.Raw(Components.Account_CurrentlyNotAuthenticated)</span>
                }
            </gcds-text>
            @{
                var currentUser = AccountService.CreateViewModelFromContext();
                currentUser.Settings.ShowUserEmail = true;
                currentUser.Settings.ShowLoginTime = true;
                currentUser.Settings.ShowUserAvatar = true;
                currentUser.Settings.ShowSessionTimeout = true;
            }
            <partial name="_AccountPartial" model="currentUser" />
            
            @if (User?.Identity?.IsAuthenticated != true)
            {
                <div class="mt-200">
                    <gcds-text>@Components.Account_SimulateLoginNote</gcds-text>
                </div>
            }
        </div>
    </gcds-grid>

    <!-- Static Examples Grid -->
    <gcds-grid columns="1fr" columns-tablet="1fr 1fr" columns-desktop="1fr 1fr" class="mt-300" equal-row-height>
        <fdcp-card>
            <gcds-heading tag="h3" size="h4" >@Components.Account_DefaultMode</gcds-heading>
            <gcds-text class="mb-200">@Components.Account_DefaultMode_Description</gcds-text>
            @{
                var defaultUser = AccountService.CreateViewModel(
                    userName: "Marie Dubois",
                    userEmail: "marie.dubois@canada.ca",
                    firstName: "Marie",
                    lastName: "Dubois",
                    userRole: "Senior Developer",
                    department: "Digital Services",
                    loginTime: DateTime.UtcNow.AddMinutes(-45),
                    sessionExpiry: DateTime.UtcNow.AddMinutes(15)
                );
                defaultUser.Settings.ShowUserEmail = true;
                defaultUser.Settings.ShowLoginTime = true;
                defaultUser.Settings.ShowUserAvatar = true;
            }
            <gcds-top-nav label="@GCFoundation.Components.Resources.Authentication.UserMenuAriaLabel" alignment="end">
                <partial name="_AccountPartial" model="defaultUser" />
            </gcds-top-nav>
        </fdcp-card>

        <fdcp-card>
            <gcds-heading tag="h3" size="h4" >@Components.Account_SessionExpiring</gcds-heading>
            <gcds-text class="mb-200">@Components.Account_SessionExpiring_Description</gcds-text>
            @{
                var expiringUser = AccountService.CreateViewModel(
                    userName: "Sarah Johnson",
                    userEmail: "sarah.johnson@canada.ca",
                    firstName: "Sarah",
                    lastName: "Johnson",
                    userRole: "UX Designer",
                    department: "User Experience",
                    loginTime: DateTime.UtcNow.AddMinutes(-115),
                    sessionExpiry: DateTime.UtcNow.AddMinutes(2) // Expires in 2 minutes
                );
                expiringUser.Settings.ShowSessionTimeout = true;
                expiringUser.Settings.ShowUserAvatar = true;
            }
            <gcds-top-nav label="@GCFoundation.Components.Resources.Authentication.UserMenuAriaLabel" alignment="end">
                <partial name="_AccountPartial" model="expiringUser" />
            </gcds-top-nav>
        </fdcp-card>
    </gcds-grid>

    <!-- Not Authenticated Example -->
    <gcds-grid columns="1fr" class="mt-200">
        <div>
            <gcds-heading tag="h3" size="h4" >@Components.Account_NotAuthenticatedState</gcds-heading>
            <gcds-text class="mb-200">@Components.Account_NotAuthenticatedState_Description</gcds-text>
            @{
                var anonymousUser = AccountService.CreateAnonymousViewModel();
            }
            <partial name="_AccountPartial" model="anonymousUser" />
        </div>
    </gcds-grid>

    <!-- Configuration Section -->
    <gcds-grid columns="1fr" class="mt-500">
        <div>
            <gcds-heading tag="h2">@Components.Account_ConfigurationOptions</gcds-heading>
            <gcds-text>
                @Components.Account_ConfigOptions_Description
            </gcds-text>
        </div>
    </gcds-grid>

        <gcds-details details-title="appsettings.json Configuration">
            <pre class="language-json"><code>{
  "AccountSettings": {
    "ShowUserName": true,
    "ShowUserEmail": false,
    "ShowLoginTime": false,
    "ShowSessionTimeout": true,
    "ShowLogoutButton": true,
    "ShowProfileLink": false,
    "ProfileUrl": "/profile",
    "LogoutUrl": "/authentication/logout",
    "LoginUrl": "/authentication/login",
    "ContainerCssClasses": "mb-200",
    "ShowUserAvatar": false,
    "CustomGreetingKey": null,
    "Position": "header",
    "DisplayMode": "Dropdown",
    "MenuItems": [
      {
        "TextEn": "My profile",
        "TextFr": "Mon profil",
        "Url": "/profile",
        "Icon": "profile"
      }
    ]
  }
}</code></pre>
        </gcds-details>

        <gcds-details details-title="Controller Usage">
            <pre class="language-csharp"><code>public class HomeController : GCFoundationBaseController
{
    public IActionResult Index()
    {
        // Enable the account partial in layout
        ViewData["AccountPartialViewName"] = "_AccountPartial";
        return View();
    }
}</code></pre>
        </gcds-details>

        <gcds-details details-title="Custom View Usage">
            <pre class="language-cshtml"><code>@@using GCFoundation.Components.Services
@@inject AccountService AccountService

@@{
    var userModel = AccountService.CreateViewModelFromContext();
}

&lt;partial name="_AccountPartial" model="userModel" /&gt;</code></pre>
        </gcds-details>

        <gcds-details details-title="Programmatic Configuration">
            <pre class="language-csharp"><code>var customSettings = new GCFoundationAccountSettings
{
    ShowUserEmail = true,
    ShowUserAvatar = true,
    ShowSessionTimeout = true
};

var userModel = _accountService.CreateViewModel(/* user info */);
userModel.Settings = customSettings;</code></pre>
        </gcds-details>

    <!-- Authentication Methods -->
    <gcds-grid columns="1fr" class="mt-400">
        <div>
            <gcds-heading tag="h2">@Components.Account_SupportedAuthMethods</gcds-heading>
            <gcds-text>
                @Components.Account_SupportedAuthMethods_Description
            </gcds-text>
            
            <gcds-grid columns="1fr" columns-tablet="1fr 1fr" class="mt-300">
                <div>
                    <gcds-heading tag="h3" size="h4" >@Components.Account_CookieAuth</gcds-heading>
                    <gcds-text>
                        @Components.Account_CookieAuth_Description
                    </gcds-text>
                    <gcds-text class="mt-200">
                        @Html.Raw(Components.Account_CookieAuth_Benefits)
                    </gcds-text>
                </div>
                
                <div>
                    <gcds-heading tag="h3" size="h4" >@Components.Account_AzureAD</gcds-heading>
                    <gcds-text>
                        @Components.Account_AzureAD_Description
                    </gcds-text>
                    <gcds-text class="mt-200">
                        @Html.Raw(Components.Account_AzureAD_Benefits)
                    </gcds-text>
                </div>
                
                <div>
                    <gcds-heading tag="h3" size="h4" >@Components.Account_JWTTokens</gcds-heading>
                    <gcds-text>
                        @Components.Account_JWTTokens_Description
                    </gcds-text>
                    <gcds-text class="mt-200">
                        @Html.Raw(Components.Account_JWTTokens_Benefits)
                    </gcds-text>
                </div>
                
                <div>
                    <gcds-heading tag="h3" size="h4" >@Components.Account_ExternalProviders</gcds-heading>
                    <gcds-text>
                        @Components.Account_ExternalProviders_Description
                    </gcds-text>
                    <gcds-text class="mt-200">
                        @Html.Raw(Components.Account_ExternalProviders_Benefits)
                    </gcds-text>
                </div>
            </gcds-grid>
        </div>
    </gcds-grid>

    <!-- Documentation Links -->
    <gcds-grid columns="1fr" class="mt-400">
        <div>
            <gcds-heading tag="h2">@Components.Account_AdditionalResources</gcds-heading>
            <gcds-grid columns="1fr" columns-tablet="1fr 1fr 1fr" class="mt-200" equal-row-height>

                <gcds-card card-title="@Components.Account_CompleteExamples" href="@Url.Action("Index", "AccountExample")" description="@Components.Account_CompleteExamples_Description" card-title-tag="h4">
                </gcds-card>
                
                <gcds-card card-title="@Components.Account_StatelessAuth" href="@Url.Action("Index", "StatelessAuthExample")" description="@Components.Account_StatelessAuth_Description" card-title-tag="h4">
                </gcds-card>

                <gcds-card card-title="@Components.Account_TemplateIntegration" href="@Url.Action("Index", "Template")" description="@Components.Account_TemplateIntegration_Description" card-title-tag="h4">
                </gcds-card>

            </gcds-grid>
        </div>
    </gcds-grid>

    <!-- Implementation Guide -->
    <gcds-grid columns="1fr" class="mt-400">
        <div>
            <gcds-heading tag="h2">@Components.Account_QuickImplementation</gcds-heading>
            <ol>
                <li>
                    <gcds-text>@Html.Raw(Components.Account_Step_ConfigureSettings)</gcds-text>
                </li>
                <li>
                    <gcds-text>@Html.Raw(Components.Account_Step_RegisterServices)</gcds-text>
                </li>
                <li>
                    <gcds-text>@Html.Raw(Components.Account_Step_SetInController)</gcds-text>
                </li>
                <li>
                    <gcds-text>@Html.Raw(Components.Account_Step_ConfigureAuth)</gcds-text>
                </li>
                <li>
                    <gcds-text>@Html.Raw(Components.Account_Step_CustomizeAppearance)</gcds-text>
                </li>
            </ol>
        </div>
    </gcds-grid>
</gcds-container>

<style nonce="@styleNonce">
    pre {
        background: var(--gcds-color-background-light);
        padding: 1rem;
        border-radius: 0.25rem;
        overflow-x: auto;
        font-size: 0.875rem;
        margin: 0.5rem 0;
    }
    
    code {
        font-family: 'Courier New', monospace;
    }
    
    .account-partial {
        border: 2px dashed var(--gcds-color-border);
        border-radius: 0.5rem;
        margin: 1rem 0;
    }
    
</style>
