@using GCFoundation.Components.Enums
@using GCFoundation.Web.Resources
@model GCFoundation.Web.Models.FormBuilderTestViewModel

@* Sample form *@
@{
    var sampleForm = Model.SampleCodeSections.First();
}
<gcds-heading tag="h2" id="@sampleForm.Id">@sampleForm.Title</gcds-heading>
@if (!string.IsNullOrEmpty(sampleForm.Description))
{
    @Html.Raw(sampleForm.Description)
}

@if (Model.SampleFormBuilder == null || Model.SampleFormBuilder.Form == null)
{
    <p class="error-text">Model.SampleFormBuilder is NULL!</p>
}
else
{
    if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <gcds-notice notice-role="@AlertType.success" notice-title-tag="h3" notice-title="@GCFoundation.Components.Resources.Localization.Validation_Success" class="mb-300">
            <gcds-text>@Model.SuccessMessage</gcds-text>
        </gcds-notice>
    }

    <fdcp-form-builder form="@Model.SampleFormBuilder.Form"></fdcp-form-builder>

    <pre><code class="language-cshtml">var form = new FormDefinition
{
    Id = "demo-form",
    Title = "Dynamic Form Demo",
    Action = Url.Action("FormBuilder", "Components") ?? "",
    Method = "post",
    SubmitButtonText = "Submit Form",
    Sections = new List<FormSection>
    {
        new FormSection
        {
            Title = "Personal Information",
            Hint = "Please provide your basic information",
            Questions = new List<FormQuestion>
            {
                new FormQuestion
                {
                    Id = "fullName",
                    Label = "Full Name",
                    Type = QuestionType.Text,
                    IsRequired = true,
                    Hint = "Enter your full legal name"
                },
                (&hellip;)
            }
        }
    }
}

&lt;fdcp-form-builder form=""@Model.SampleFormBuilder.Form""&gt;&gl;/fdcp-form-builder&gt;</code></pre>
}