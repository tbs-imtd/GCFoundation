@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var countryOptions = new List<SelectListItem>
    {
        new() { Value = "CA", Text = Components.SearchableSelect_Sample_Country_CA },
        new() { Value = "US", Text = Components.SearchableSelect_Sample_Country_US },
        new() { Value = "MX", Text = Components.SearchableSelect_Sample_Country_MX },
        new() { Value = "FR", Text = Components.SearchableSelect_Sample_Country_FR },
        new() { Value = "SV", Text = Components.SearchableSelect_Sample_Country_SV },
        new() { Value = "GB", Text = Components.SearchableSelect_Sample_Country_GB },
        new() { Value = "DE", Text = Components.SearchableSelect_Sample_Country_DE },
        new() { Value = "IT", Text = Components.SearchableSelect_Sample_Country_IT },
        new() { Value = "ES", Text = Components.SearchableSelect_Sample_Country_ES },
        new() { Value = "JP", Text = Components.SearchableSelect_Sample_Country_JP },
        new() { Value = "AU", Text = Components.SearchableSelect_Sample_Country_AU },
        new() { Value = "BR", Text = Components.SearchableSelect_Sample_Country_BR },
        new() { Value = "IN", Text = Components.SearchableSelect_Sample_Country_IN },
        new() { Value = "ZA", Text = Components.SearchableSelect_Sample_Country_ZA },
        new() { Value = "NZ", Text = Components.SearchableSelect_Sample_Country_NZ }
    };
}

<div class="searchable-select-basic-example">
    <fdcp-searchable-select items="@countryOptions"
                              name="country"
                              label="@Components.SearchableSelect_Sample_Country_Label"
                              hint="@Components.SearchableSelect_Sample_Country_Hint"
                              default-value="@Components.SearchableSelect_Sample_Country_DefaultValue"
                              search-placeholder="@Components.SearchableSelect_Sample_Country_SearchPlaceholder"
                              no-results-text="@Components.SearchableSelect_Sample_Country_NoResultsText"
                              one-result-text="@Components.SearchableSelect_Sample_OneResultText"
                              multiple-results-text="@Components.SearchableSelect_Sample_MultipleResultsText"></fdcp-searchable-select>
</div>

