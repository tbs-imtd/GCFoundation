@using GCFoundation.Components.Enums
@using GCFoundation.Components.TagHelpers.FDCP
@using GCFoundation.Web.Resources
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var economicsGroup = new SelectListGroup { Name = Components.SearchableSelect_Sample_Classification_EC_Group };
    var policyGroup = new SelectListGroup { Name = Components.SearchableSelect_Sample_Classification_PM_Group };
    var classificationOptions = new List<SelectListItem>
    {
        new() { Value = "EC-02", Text = "EC-02", Group = economicsGroup },
        new() { Value = "EC-03", Text = "EC-03", Group = economicsGroup },
        new() { Value = "EC-04", Text = "EC-04", Group = economicsGroup },
        new() { Value = "EC-05", Text = "EC-05", Group = economicsGroup },
        new() { Value = "EC-06", Text = "EC-06", Group = economicsGroup },
        new() { Value = "PM-03", Text = "PM-03", Group = policyGroup },
        new() { Value = "PM-04", Text = "PM-04", Group = policyGroup }
    };
}

<fdcp-searchable-select items="@classificationOptions"
                          name="classificationLevels"
                          label="@Components.SearchableSelect_Sample_Classification_Label"
                          default-value="@Components.SearchableSelect_Sample_Classification_DefaultValue"
                          search-placeholder="@Components.SearchableSelect_Sample_Classification_SearchPlaceholder"
                          no-results-text="@Components.SearchableSelect_Sample_Classification_NoResultsText"
                          one-result-text="@Components.SearchableSelect_Sample_OneResultText"
                          multiple-results-text="@Components.SearchableSelect_Sample_MultipleResultsText"
                          multiple-selected-text="@Components.SearchableSelect_Sample_Classification_TriggerSelectedText"
                          selection-mode="@FDCPSearchableSelectSelectionMode.Multiple">
    <div slot="selected-options">
        <span><strong data-fdcp-searchable-select-selected-count>0</strong> @Components.SearchableSelect_Sample_Classification_SelectedCountText</span>
        <gcds-button type="button" button-role="secondary" data-fdcp-searchable-select-clear>@Components.SearchableSelect_Sample_Classification_ClearText</gcds-button>
    </div>
</fdcp-searchable-select>

